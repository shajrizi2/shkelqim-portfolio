# PUBLIC, embedded at build time. Keep canonicals on the production origin.
NEXT_PUBLIC_SITE_URL=https://hajrizi.dev
# Optional GA4 web stream ID. Blank = no collection. Production hostname only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_HOSTNAME=hajrizi.dev
# Optional Search Console URL-prefix HTML verification token (not the full tag).
# DNS verification of sc-domain:hajrizi.dev does not need this variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SERVER ONLY. Set in Netlify with Functions scope, never prefix with NEXT_PUBLIC_.
# Leave disabled until the Google OAuth client and owner allowlist are configured.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_ORIGIN=https://hajrizi.dev
# Exact owner Google account email(s), comma separated. No wildcard domains.
DASHBOARD_ALLOWED_EMAILS=
# Generate at least 32 random bytes: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
# Google Cloud Web OAuth client (openid/email login only).
# Authorized redirect: https://hajrizi.dev/dashboard/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Reporting credentials: single-line service-account JSON. Never a public file.
# Grant Viewer on GA4 and read-only/Restricted user access on Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric GA4 PROPERTY ID, not G-XXXX.
GA4_PROPERTY_ID=
# Public site being reported; distinct from dashboard origin on a preview.
ANALYTICS_SITE_ORIGIN=https://hajrizi.dev
# Domain property (recommended): sc-domain:hajrizi.dev
# Or an EXACT verified URL-prefix property: https://hajrizi.dev/
SEARCH_CONSOLE_SITE_URL=
