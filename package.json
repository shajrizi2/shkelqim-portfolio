{
  "name": "shkelqim-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run typecheck && next build --webpack && npm run build:dashboard",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:seo": "tsx scripts/check-seo.ts",
    "preview": "tsx scripts/preview.ts",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "audit:live": "tsx scripts/audit-live.ts",
    "test:function": "node scripts/check-function.mjs"
  },
  "dependencies": {
    "google-auth-library": "^11.3.2",
    "lucide-react": "0.548.0",
    "next": "^16.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.4.4",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
